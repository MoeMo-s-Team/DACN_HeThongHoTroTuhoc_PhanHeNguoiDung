{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "code": "VALIDATION_ERROR",
                  "message": "Dữ liệu đầu vào không hợp lệ.",
                  "details": [
                    "email must be an email"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "code": "INVALID_CREDENTIALS",
                  "message": "Thông tin đăng nhập không hợp lệ.",
                  "details": null
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "code": "ACCOUNT_DISABLED",
                  "message": "Tài khoản đã bị vô hiệu hóa.",
                  "details": null
                }
              }
            }
          },
          "500": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "code": "DATABASE_FAILURE",
                  "message": "Không thể xử lý yêu cầu.",
                  "details": null
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSummaryDto"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "code": "AUTH_REQUIRED",
                  "message": "Yêu cầu đăng nhập hợp lệ.",
                  "details": null
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "code": "ACCOUNT_DISABLED",
                  "message": "Tài khoản đã bị vô hiệu hóa.",
                  "details": null
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "code": "AUTH_REQUIRED",
                  "message": "Yêu cầu đăng nhập hợp lệ.",
                  "details": null
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponseDto"
                },
                "example": {
                  "code": "ACCOUNT_DISABLED",
                  "message": "Tài khoản đã bị vô hiệu hóa.",
                  "details": null
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "Self-study Support API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "student@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "user_opaque_id"
          },
          "fullName": {
            "type": "string",
            "example": "Nguyen Van A"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "student@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER",
              "ADMINISTRATOR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          }
        },
        "required": [
          "id",
          "fullName",
          "email",
          "role",
          "status"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummaryDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "type": "string",
            "example": "Thông tin đăng nhập không hợp lệ."
          },
          "details": {
            "oneOf": [
              {
                "type": "object",
                "nullable": true,
                "additionalProperties": true
              },
              {
                "type": "array",
                "items": {}
              }
            ],
            "description": "Additional safe error details; may be null, an object, or an array."
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      }
    }
  }
}
