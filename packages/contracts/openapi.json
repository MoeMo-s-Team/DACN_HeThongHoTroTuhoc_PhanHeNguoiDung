  "info": {
    "title": "Self-study Support API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "student@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "user_opaque_id"
          },
          "fullName": {
            "type": "string",
            "example": "Nguyen Van A"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "student@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER",
              "ADMINISTRATOR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          }
        },
        "required": [
          "id",
          "fullName",
          "email",
          "role",
          "status"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummaryDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "type": "string",
            "example": "Thông tin đăng nhập không hợp lệ."
          },
          "details": {
            "oneOf": [
              {
                "type": "object",
                "nullable": true,
                "additionalProperties": true
              },
              {
                "type": "array",
                "items": {}
              }
            ],
            "description": "Additional safe error details; may be null, an object, or an array."
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "TopicViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AssessmentResultViewDto": {
        "type": "object",
        "properties": {
          "topic": {
            "$ref": "#/components/schemas/TopicViewDto"
          },
          "score": {
            "type": "number"
          },
          "classification": {
            "type": "string",
            "enum": [
              "GOOD",
              "NEEDS_REINFORCEMENT",
              "PRIORITY"
            ]
          },
          "evaluatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "topic",
          "score",
          "classification",
          "evaluatedAt"
        ]
      },
      "StudentDashboardPlanDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COMPLETED"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "goal",
          "status",
          "startDate",
          "endDate"
        ]
      },
      "ProgressViewDto": {
        "type": "object",
        "properties": {
          "completedTasks": {
            "type": "number"
          },
          "totalTasks": {
            "type": "number"
          },
          "completionPercentage": {
            "type": "number"
          },
          "actualProgress": {
            "type": "number"
          },
          "expectedProgress": {
            "type": "number"
          },
          "overdueTasks": {
            "type": "number"
          },
          "slowProgress": {
            "type": "boolean"
          }
        },
        "required": [
          "completedTasks",
          "totalTasks",
          "completionPercentage",
          "actualProgress",
          "expectedProgress",
          "overdueTasks",
          "slowProgress"
        ]
      },
      "StudyTaskViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "topic": {
            "$ref": "#/components/schemas/TopicViewDto"
          },
          "title": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "expectedMinutes": {
            "type": "number"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "TODO",
              "COMPLETED"
            ]
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "topic",
          "title",
          "goal",
          "expectedMinutes",
          "dueDate",
          "priority",
          "status",
          "completedAt"
        ]
      },
      "StudentDashboardResponseDto": {
        "type": "object",
        "properties": {
          "assessmentResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssessmentResultViewDto"
            }
          },
          "currentPlan": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/StudentDashboardPlanDto"
              }
            ]
          },
          "progress": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProgressViewDto"
              }
            ]
          },
          "nearDueTasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StudyTaskViewDto"
            }
          },
          "overdueTaskItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StudyTaskViewDto"
            }
          }
        },
        "required": [
          "assessmentResults",
          "currentPlan",
          "progress",
          "nearDueTasks",
          "overdueTaskItems"
        ]
      },
      "StudentAssessmentResultsResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssessmentResultViewDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ValidateStudyContextResponseDto": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "availableMinutesPerWeek": {
            "type": "number",
            "example": 450,
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "targetDeadline": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "goal",
          "availableMinutesPerWeek",
          "targetDeadline"
        ]
      },
      "StudentStudyTasksResponseDto": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string",
            "nullable": true
          },
          "planStatus": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "COMPLETED"
            ],
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StudyTaskViewDto"
            }
          }
        },
        "required": [
          "planId",
          "planStatus",
          "items"
        ]
      },
      "UpdateStudyTaskStatusRequestDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "TODO",
              "COMPLETED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "UpdatedStudyTaskDto": {
        "type": "object",
