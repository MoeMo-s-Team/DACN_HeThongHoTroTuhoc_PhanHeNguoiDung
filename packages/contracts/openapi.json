  "info": {
    "title": "Self-study Support API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "student@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "user_opaque_id"
          },
          "fullName": {
            "type": "string",
            "example": "Nguyen Van A"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "student@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "STUDENT",
              "TEACHER",
              "ADMINISTRATOR"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          }
        },
        "required": [
          "id",
          "fullName",
          "email",
          "role",
          "status"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummaryDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_CREDENTIALS"
          },
          "message": {
            "type": "string",
            "example": "Thông tin đăng nhập không hợp lệ."
          },
          "details": {
            "oneOf": [
              {
                "type": "object",
                "nullable": true,
                "additionalProperties": true
              },
              {
                "type": "array",
                "items": {}
              }
            ],
            "description": "Additional safe error details; may be null, an object, or an array."
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ]
      },
      "TopicViewDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "AssessmentResultViewDto": {
        "type": "object",
        "properties": {
          "topic": {
            "$ref": "#/components/schemas/TopicViewDto"
          },
          "score": {
            "type": "number"
          },
          "classification": {
            "type": "string",
            "enum": [
              "GOOD",
              "NEEDS_REINFORCEMENT",
              "PRIORITY"
            ]
          },
          "evaluatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "topic",
          "score",
          "classification",
          "evaluatedAt"
        ]
      },
      "StudentDashboardPlanDto": {
