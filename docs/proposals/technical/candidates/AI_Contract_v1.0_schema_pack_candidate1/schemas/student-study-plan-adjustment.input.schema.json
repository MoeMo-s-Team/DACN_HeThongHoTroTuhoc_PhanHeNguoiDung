{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-candidate1:student-study-plan-adjustment.input",
  "$comment": "CANDIDATE — NOT APPROVED",
  "type": "object",
  "properties": {
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "todoTasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/todoTask"
      }
    },
    "actualProgress": {
      "type": "number"
    },
    "expectedProgress": {
      "type": "number"
    },
    "overdueTasks": {
      "type": "integer"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "remainingMinutes": {
      "type": "number"
    }
  },
  "additionalProperties": false,
  "required": [
    "plan",
    "todoTasks",
    "actualProgress",
    "expectedProgress",
    "overdueTasks",
    "goal",
    "remainingMinutes"
  ],
  "$defs": {
    "plan": {
      "type": "object",
      "properties": {
        "startDate": {
          "type": "string",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false,
      "required": [
        "startDate",
        "endDate"
      ]
    },
    "todoTask": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "expectedMinutes": {
          "type": "number"
        },
        "dueDate": {
          "type": "string",
          "format": "date-time"
        },
        "priority": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "taskId"
      ]
    }
  }
}
