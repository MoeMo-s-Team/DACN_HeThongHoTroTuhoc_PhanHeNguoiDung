{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-candidate1:student-study-plan-generation.output",
  "$comment": "CANDIDATE — NOT APPROVED",
  "type": "object",
  "properties": {
    "planTitle": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "planTitle",
    "tasks"
  ],
  "$defs": {
    "task": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "topicId": {
          "type": "string"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "expectedMinutes": {
          "type": "number"
        },
        "dueDate": {
          "type": "string",
          "format": "date-time"
        },
        "priority": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "topicId",
        "goal",
        "expectedMinutes",
        "dueDate",
        "priority",
        "reason"
      ]
    }
  }
}
