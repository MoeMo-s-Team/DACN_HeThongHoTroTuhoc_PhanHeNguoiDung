{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-candidate1:teacher-class-analysis.output",
  "$comment": "CANDIDATE — NOT APPROVED",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "weakTopics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/weakTopic"
      }
    },
    "progressIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/progressIssue"
      }
    },
    "attentionGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attentionGroup"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "summary",
    "weakTopics",
    "progressIssues",
    "attentionGroups",
    "recommendations"
  ],
  "$defs": {
    "weakTopic": {
      "type": "object",
      "properties": {
        "topicId": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "topicId",
        "reason"
      ]
    },
    "progressIssue": {
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "studentId",
        "description"
      ]
    },
    "attentionGroup": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "studentIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "studentIds",
        "description"
      ]
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ]
    }
  }
}
