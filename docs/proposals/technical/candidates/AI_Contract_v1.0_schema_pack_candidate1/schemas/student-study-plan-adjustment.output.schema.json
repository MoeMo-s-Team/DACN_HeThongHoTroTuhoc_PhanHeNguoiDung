{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-candidate1:student-study-plan-adjustment.output",
  "$comment": "CANDIDATE — NOT APPROVED",
  "type": "object",
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "changes"
  ],
  "$defs": {
    "change": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "expectedMinutes": {
          "type": "number"
        },
        "dueDate": {
          "type": "string",
          "format": "date-time"
        },
        "priority": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "taskId"
      ]
    }
  }
}
