{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-release1:inference-success-envelope",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/taskName"
    },
    "output": {
      "type": "object"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    }
  },
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "task",
    "output",
    "runtime"
  ],
  "$defs": {
    "runtime": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "modelId",
        "promptVersion"
      ]
    },
    "taskName": {
      "type": "string",
      "enum": [
        "STUDENT_LEARNING_ANALYSIS",
        "STUDENT_STUDY_PLAN_GENERATION",
        "STUDENT_STUDY_PLAN_ADJUSTMENT",
        "TEACHER_CLASS_ANALYSIS",
        "ADMIN_FEEDBACK_GROUPING_STAGE1",
        "ADMIN_FEEDBACK_SUMMARY_STAGE2"
      ]
    }
  }
}
