{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-release1:admin-feedback-summary-stage2.input",
  "type": "object",
  "properties": {
    "feedback": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feedbackItem"
      }
    },
    "totalFeedback": {
      "type": "integer"
    },
    "tagStatistics": {
      "$ref": "#/$defs/tagStatistics"
    },
    "issueGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issueGroup"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "feedback",
    "totalFeedback",
    "tagStatistics",
    "issueGroups"
  ],
  "$defs": {
    "feedbackItem": {
      "type": "object",
      "properties": {
        "feedbackId": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "enum": [
            "AI_PERFORMANCE",
            "STUDY_PLAN",
            "UI_UX",
            "LEARNING_ANALYTICS",
            "OTHER"
          ]
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "feedbackId",
        "tag",
        "rating",
        "content"
      ]
    },
    "tagStatistics": {
      "type": "object",
      "properties": {
        "AI_PERFORMANCE": {
          "type": "integer"
        },
        "STUDY_PLAN": {
          "type": "integer"
        },
        "UI_UX": {
          "type": "integer"
        },
        "LEARNING_ANALYTICS": {
          "type": "integer"
        },
        "OTHER": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "AI_PERFORMANCE",
        "STUDY_PLAN",
        "UI_UX",
        "LEARNING_ANALYTICS",
        "OTHER"
      ]
    },
    "issueGroup": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "feedbackIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "count": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "feedbackIds",
        "count"
      ]
    }
  }
}
