{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-release1:student-study-plan-generation.input",
  "type": "object",
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "availableMinutesPerWeek": {
      "type": "number"
    },
    "planningStartAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetDeadline": {
      "type": "string",
      "format": "date-time"
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "learningAnalysisContext": {
      "anyOf": [
        {
          "$ref": "#/$defs/learningAnalysis"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "goal",
    "availableMinutesPerWeek",
    "planningStartAt",
    "targetDeadline",
    "assessments",
    "topics"
  ],
  "$defs": {
    "assessment": {
      "type": "object",
      "properties": {
        "topicId": {
          "type": "string"
        },
        "topicName": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        },
        "classification": {
          "type": "string",
          "enum": [
            "GOOD",
            "NEEDS_REINFORCEMENT",
            "PRIORITY"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "topicId",
        "topicName",
        "score",
        "classification"
      ]
    },
    "topic": {
      "type": "object",
      "properties": {
        "topicId": {
          "type": "string"
        },
        "topicName": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "topicId",
        "topicName"
      ]
    },
    "learningAnalysis": {
      "type": "object",
      "properties": {
        "strengths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "areasToImprove": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priorityTopics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topicId": {
                "type": "string"
              },
              "topicName": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "topicId",
              "topicName",
              "reason"
            ]
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "strengths",
        "areasToImprove",
        "priorityTopics",
        "reasons"
      ],
      "additionalProperties": false
    }
  }
}
