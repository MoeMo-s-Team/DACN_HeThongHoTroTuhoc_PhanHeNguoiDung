{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-release1:inference-request-envelope",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/taskName"
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "requestId",
    "task",
    "locale",
    "input"
  ],
  "$defs": {
    "taskName": {
      "type": "string",
      "enum": [
        "STUDENT_LEARNING_ANALYSIS",
        "STUDENT_STUDY_PLAN_GENERATION",
        "STUDENT_STUDY_PLAN_ADJUSTMENT",
        "TEACHER_CLASS_ANALYSIS",
        "ADMIN_FEEDBACK_GROUPING_STAGE1",
        "ADMIN_FEEDBACK_SUMMARY_STAGE2"
      ]
    }
  }
}
