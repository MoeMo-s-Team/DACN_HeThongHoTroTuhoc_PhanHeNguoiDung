{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-release1:teacher-class-analysis.input",
  "type": "object",
  "properties": {
    "classId": {
      "type": "string"
    },
    "studentCount": {
      "type": "integer"
    },
    "classAverageScore": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "topicAverageScores": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topicScore"
      }
    },
    "classCompletionRate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "overdueTaskCount": {
      "type": "integer"
    },
    "needsAttentionStudents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attentionStudent"
      }
    },
    "progressWarnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/progressWarning"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "classId",
    "studentCount",
    "classAverageScore",
    "topicAverageScores",
    "classCompletionRate",
    "overdueTaskCount",
    "needsAttentionStudents",
    "progressWarnings"
  ],
  "$defs": {
    "apiTopic": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "topicScore": {
      "type": "object",
      "properties": {
        "topic": {
          "$ref": "#/$defs/apiTopic"
        },
        "averageScore": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "weakTopic": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "topic",
        "averageScore",
        "weakTopic"
      ]
    },
    "attentionStudent": {
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "studentId",
        "reasons"
      ]
    },
    "progressWarning": {
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string"
        },
        "actualProgress": {
          "type": "number"
        },
        "expectedProgress": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "studentId",
        "actualProgress",
        "expectedProgress"
      ]
    }
  }
}
