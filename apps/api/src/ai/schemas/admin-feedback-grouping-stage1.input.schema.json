{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-release1:admin-feedback-grouping-stage1.input",
  "type": "object",
  "properties": {
    "feedback": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feedbackItem"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "feedback"
  ],
  "$defs": {
    "feedbackItem": {
      "type": "object",
      "properties": {
        "feedbackId": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "enum": [
            "AI_PERFORMANCE",
            "STUDY_PLAN",
            "UI_UX",
            "LEARNING_ANALYTICS",
            "OTHER"
          ]
        },
        "rating": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "feedbackId",
        "tag",
        "rating",
        "content"
      ]
    }
  }
}
