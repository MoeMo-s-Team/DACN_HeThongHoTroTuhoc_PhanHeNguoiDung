{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:ai-contract:v1.0:schema-pack-release1:admin-feedback-grouping-stage1.output",
  "type": "object",
  "properties": {
    "issueGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issueGroup"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "issueGroups"
  ],
  "$defs": {
    "issueGroup": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "feedbackIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "feedbackIds"
      ]
    }
  }
}
